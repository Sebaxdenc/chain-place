# Copia esto a .env y rellena con tus valores.
# OJO: en Vite, todo lo que empiece por VITE_ queda EMBEBIDO EN EL BUNDLE y es
# público. Nunca pongas aquí una private key.

# Dirección del contrato BlitzCanvas
VITE_CANVAS_ADDRESS=0x33F5eC093f6Cc61ee0Dd407ceb7ccba136B86E8e

# Relay. En local es ws://localhost:8787; a través de cloudflared, wss://...
VITE_RELAY_URL=ws://localhost:8787

# RPC al que los celulares mandan sus transacciones.
# Para el evento usa uno dedicado (Alchemy/QuickNode tienen tier gratis):
# el público aguanta 15-25 req/s y 100 personas pintando lo tumban.
VITE_RPC_URL=https://testnet-rpc.monad.xyz
